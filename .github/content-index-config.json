{
  "schema_version": 1,
  "repository": "MicrosoftDocs/win32-pr",
  "index_path": ".github/content-index.jsonl",
  "docsets": [
    {
      "name": "win32",
      "root": "desktop-src",
      "url_prefix": "https://learn.microsoft.com/windows/win32",
      "status": "current"
    }
  ],
  "exclude_path_parts": [
    "code",
    "include",
    "includes",
    "node_modules",
    "obj",
    "sample",
    "samples"
  ],
  "exclude_filenames": [
    "README.md"
  ],
  "exclude_topics": [
    "error-reference",
    "include",
    "language-reference",
    "reference"
  ],
  "exclude_metadata_keys": [
    "api_name",
    "req.header",
    "topic_type",
    "uid"
  ],
  "exclude_generated_api_reference": true,
  "max_terms": 120
}
